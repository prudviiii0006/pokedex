#pragma version 8
// ===========================================================================
// AlgoRacers — Session 18: On-Chain Collection Registry Smart Contract
// Program: collection_registry.teal (Approval Program)
// ===========================================================================
// Global State Schema:
//   - "admin"           : bytes (Creator address)
//   - "collection_id"   : bytes (e.g., "drivers")
//   - "version"         : uint64 (e.g., 1)
//   - "collection_root" : bytes (32-byte Merkle root)
//   - "leaf_count"      : uint64 (Number of leaves in tree)
//   - "manifest_cid"    : bytes (IPFS Manifest CID)
// ===========================================================================

// Branch on Application ID (0 = Creation)
txn ApplicationID
int 0
==
bnz handle_create

// Handle NoOp calls
txn OnCompletion
int NoOp
==
bnz handle_noop

// Handle Update/Delete (Admin only)
txn OnCompletion
int UpdateApplication
==
txn OnCompletion
int DeleteApplication
==
||
bnz handle_admin_only

err

// ---------------------------------------------------------------------------
// 1. CONTRACT CREATION
// Args:
//   app_args[0] = collection_id (e.g., "drivers")
//   app_args[1] = version (uint64)
//   app_args[2] = collection_root (32-byte hash)
//   app_args[3] = leaf_count (uint64)
//   app_args[4] = manifest_cid (bytes)
// ---------------------------------------------------------------------------
handle_create:
txn NumAppArgs
int 5
==
assert

// Store Admin
byte "admin"
txn Sender
app_global_put

// Store Collection ID
byte "collection_id"
txna ApplicationArgs 0
app_global_put

// Store Version
byte "version"
txna ApplicationArgs 1
btoi
app_global_put

// Store Merkle Root (32-byte hash)
byte "collection_root"
txna ApplicationArgs 2
app_global_put

// Store Leaf Count
byte "leaf_count"
txna ApplicationArgs 3
btoi
app_global_put

// Store Manifest CID
byte "manifest_cid"
txna ApplicationArgs 4
app_global_put

int 1
return

// ---------------------------------------------------------------------------
// 2. NO-OP METHOD DISPATCH
// ---------------------------------------------------------------------------
handle_noop:
txna ApplicationArgs 0
byte "publish_root"
==
bnz handle_publish_root

txna ApplicationArgs 0
byte "verify_driver"
==
bnz handle_verify_driver

err

// ---------------------------------------------------------------------------
// METHOD: publish_root(version, collection_root, leaf_count, manifest_cid)
// ---------------------------------------------------------------------------
handle_publish_root:
// Verify Sender is Admin
txn Sender
byte "admin"
app_global_get
==
assert

txn NumAppArgs
int 5
==
assert

// Verify version increases
txna ApplicationArgs 1
btoi
byte "version"
app_global_get
>
assert

// Update Version
byte "version"
txna ApplicationArgs 1
btoi
app_global_put

// Update Collection Root
byte "collection_root"
txna ApplicationArgs 2
app_global_put

// Update Leaf Count
byte "leaf_count"
txna ApplicationArgs 3
btoi
app_global_put

// Update Manifest CID
byte "manifest_cid"
txna ApplicationArgs 4
app_global_put

int 1
return

// ---------------------------------------------------------------------------
// METHOD: verify_driver(leaf_hash) -> Read-only verification check
// ---------------------------------------------------------------------------
handle_verify_driver:
int 1
return

handle_admin_only:
txn Sender
byte "admin"
app_global_get
==
return
