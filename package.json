{
  "name": "pokedex",
  "version": "1.0.0",
  "private": true,
  "description": "Pokédex — 1-of-1 Digital Pokémon Collectibles on Algorand",
  "scripts": {
    "build": "npm --prefix projects/frontend run build",
    "start": "npm --prefix projects/backend run start",
    "frontend:dev": "npm --prefix projects/frontend run dev",
    "frontend:build": "npm --prefix projects/frontend run build",
    "backend:dev": "npm --prefix projects/backend run dev",
    "backend:start": "npm --prefix projects/backend run start",
    "test:backend": "pytest projects/backend/tests/ -v",
    "test:metadata": "pytest projects/backend/tests/test_ipfs_metadata.py -v"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@x402-avm/extensions": "^2.6.1",
    "@x402/avm": "^2.25.0",
    "@x402/core": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "@x402/hono": "^2.25.0",
    "algosdk": "^3.7.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
